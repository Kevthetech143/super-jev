{
 "_comment": "One secret-pattern source for Python has_secret and Node containsSecret. Flags are case-insensitive except card/date/url.",
 "card": "[0-9]{4}[- ]?[0-9]{4}[- ]?[0-9]{4}[- ]?[0-9]{4}",
 "word": "(?<![0-9])password|passwd|api[_-]?key",
 "token": "\\b(?=[0-9abceghmnprsx])(?:(?:sk|rk)_(?:live|test)_[0-9a-zA-Z]{10,}|sk-(?:proj|svcacct|ant)-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|gh[pousr]_[0-9a-zA-Z]{30,}|github_pat_[0-9a-zA-Z_]{22,}|(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\\b|xox[abposr]-[0-9A-Za-z-]{10,}|Bearer\\s+[A-Za-z0-9._~+/-]{20,}|AIza[0-9A-Za-z_-]{35}|eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}|\\d{8,10}:AA[\\w-]{30,}|SG\\.[\\w-]{16,}\\.[\\w-]{16,}|hf_[A-Za-z0-9]{30,}|[MN][A-Za-z0-9]{23,25}\\.[\\w-]{6}\\.[\\w-]{27,}|(?:api|secret|access|auth|client|private)[\\s_-]?(?:key|token|secret)\\s*[:=])|aws_secret_access_key\\s*[:=]|-----BEGIN[A-Z ]*PRIVATE KEY-----|Authorization:\\s*Basic\\s+[A-Za-z0-9+/=]{8,}",
 "generic": "(?<![A-Za-z0-9])(?:key|token|secret|passwd|pwd)(?=([\\w-]{0,40}))\\1[\\\"']?(?=(\\s*))\\2[:=](?=(\\s*))\\3[\\\"']?(?=([A-Za-z0-9_+/=.-]{20,}))\\4",
 "iso_date": "\\b\\d{4}-\\d{2}-\\d{2}\\b",
 "url": "https?://\\S+"
}