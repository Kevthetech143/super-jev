{
 "_comment": "One secret-pattern source for Python has_secret and Node containsSecret. Held: a known token shape, a Luhn-valid card, or a password/key keyword followed by a literal value (the value has a digit or symbol and is not a placeholder or a call). Not held: an identifier, attribute, call, '...', a 'moved to' note, or a placeholder; 'placeholder' is the one shared list, {PH} in a rule. Both sides run these ASCII-only on normalized text (NFKC, casefold, whitespace/control to space, non-ASCII letter to x, digit to 0). Cards: 16 digits (Luhn) standing alone; a later 16-digit window in a grouped run also needs a card-network prefix (card_iin) and 1-4 groups before, at most 4 after, at most 2 of 4+ digits per side; 'amex' is 15 digits starting 34/37; a whole USPS 'tracking' run with a valid check digit is removed before the card check.",
 "placeholder": "(?:(?:<[^<>\"'\\n]{0,200}>|\\$\\([^()\"'\\n]{0,200}\\)|\\$\\{[^{}\"'\\n]{0,200}\\}|(?<!\\\\[\"'])\\$[a-z_][a-z0-9_]*)(?=\\\\?[\"']|[\\s,;]|$)|[a-z_][a-z0-9_.]*\\([^()\\n]{0,200}\\))",
 "card": "(?<![0-9A-Za-z])[0-9]{4}[- ]?[0-9]{4}[- ]?[0-9]{4}[- ]?[0-9]{4}(?![0-9A-Za-z])",
 "card_iin": "^(?:4|5[0-8]|6(?:011|2|304|4[4-9]|5|7)|3(?:0[0-5]|095|[68]|5(?:2[89]|[3-8]))|2(?:20[0-4]|22[1-9]|2[3-9]|[3-6]|7[01]|720))",
 "amex": "(?<![0-9A-Za-z])3[47][0-9]{2}(?:([- ]?)[0-9]{6}\\1[0-9]{5}|([- ])[0-9]{4}\\2[0-9]{4}\\2[0-9]{3})(?![0-9A-Za-z])",
 "word": "(?<![0-9])(?:password|passwd|(?:api|secret|access|auth|client|private)[\\s_-]?(?:key|token|secret))s?[\\\"']?\\s*[:=]\\s*(?:\\\\?[\\\"'])?(?:(?!{PH})(?=[^\\s\\\"']*[0-9!@#$%^&*+?~|`])[^\\s\\\"']+|(?<=[\\\"'])(?!{STOP})[a-z]+(?=\\\\?[\\\"'])|(?!{STOP})[a-z]{4,}(?=[ \\t]*(?:\\n|$)))|(?<![0-9])(?:password|passwd|api[_-]?key)s?(?:\\s+[a-z0-9_.-]+){0,4}?\\s+(?:is|was)\\s+[\\\"']?(?=[^\\s\\\"']*[0-9!@#$%^&*])[^\\s\\\"']{4,}",
 "token": "(?:sk|rk)_(?:live|test)_[0-9a-zA-Z]{10,}|\\b(?=[0-9abeghmnsx])(?:sk-(?:proj|svcacct|ant)-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|gh[pousr]_[0-9a-zA-Z]{30,}|github_pat_[0-9a-zA-Z_]{22,}|(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\\b|xox[abposr]-[0-9A-Za-z-]{10,}|Bearer\\s+[A-Za-z0-9._~+/-]{20,}|AIza[0-9A-Za-z_-]{35}|eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}|\\d{8,10}:AA[\\w-]{30,}|SG\\.[\\w-]{16,}\\.[\\w-]{16,}|hf_[A-Za-z0-9]{30,}|[MN][A-Za-z0-9]{23,25}\\.[\\w-]{6}\\.[\\w-]{27,})|-----BEGIN[A-Z ]*PRIVATE KEY-----|Authorization:\\s*Basic\\s+[A-Za-z0-9+/=]{8,}|\\b[a-z][a-z0-9+.-]{1,20}://[^\\s:/@]*:[^\\s:/@$<>{}'\"]{3,}@|hooks\\.slack\\.com/services/[a-z0-9]+/[a-z0-9]+/[a-z0-9]+",
 "generic": "(?<![A-Za-z0-9])(?:key|token|secret|passwd|pwd)(?=([\\w-]{0,40}))\\1[\\\"']?(?=(\\s*))\\2[:=](?=(\\s*))\\3[\\\"']?(?=([A-Za-z0-9_+/=.-]{20,}))\\4",
 "iso_date": "\\b\\d{4}-\\d{2}-\\d{2}\\b",
 "url": "https?://\\S+",
 "tracking": "(?<![0-9A-Za-z])(?<![0-9][- ])9[1-5][0-9]{2}([- ])[0-9]{4}(?:\\1[0-9]{4}){3,4}\\1[0-9]{2}(?![0-9A-Za-z]|[- ][0-9])",
 "stop": "(?:see|in|none|yes|no|demo|str|true|false|env|vault|null|todo|example|here|below|above)(?![a-z0-9_-])"
}
